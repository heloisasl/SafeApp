{
  "expo": {
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/slash.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/slash_splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.safeapp.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/slash.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.safeapp.app"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-local-authentication",
        { "faceIDPermission": "O SafeApp usa o Face ID para confirmar que é você abrindo o aplicativo." }
      ]
    ]
  }
}